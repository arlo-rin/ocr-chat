    <!-- Home Guide -->
    <string name="guide_title">三步上手</string>
    <string name="guide_step_1_title">开启 Root 悬浮球</string>
    <string name="guide_step_1_desc">一键完成悬浮窗与前台识别授权，并配置支持识图的模型接口。</string>
    <string name="guide_step_2_title">在微信里轻点侧边小球</string>
    <string name="guide_step_2_desc">侧答会先隐藏自身再截屏，压缩为 JPEG 直接发给识图模型。</string>
    <string name="guide_step_3_title">选语气、点一下即复制</string>
    <string name="guide_step_3_desc">三条不同语气可直接复制粘贴，也可指定风格继续换一组。</string>

