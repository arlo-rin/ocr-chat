<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_inner"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tv_round_meta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_tight"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_round_user"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:background="@drawable/bg_chat_user"
            android:paddingStart="@dimen/space_inner"
            android:paddingTop="@dimen/space_tight"
            android:paddingEnd="@dimen/space_inner"
            android:paddingBottom="@dimen/space_tight"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnPrimaryContainer" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_tight"
        android:gravity="start"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_round_ai"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="32dp"
            android:background="@drawable/bg_chat_ai"
            android:paddingStart="@dimen/space_inner"
            android:paddingTop="@dimen/space_tight"
            android:paddingEnd="@dimen/space_inner"
            android:paddingBottom="@dimen/space_tight"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurface" />
    </LinearLayout>
</LinearLayout>
